<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Keep the original namespaces so linked sources compile unchanged -->
    <RootNamespace>MOTW_Cleaner</RootNamespace>
    <AssemblyName>MOTW-Cleaner-Portable</AssemblyName>
    <AssemblyTitle>MOTW Cleaner Portable</AssemblyTitle>
    <Product>MOTW Cleaner Portable</Product>
    <Version>1.3.1.0</Version>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- frmMOTW.resx embeds an ImageList stream serialized with BinaryFormatter -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>

    <!-- Portable single-file publish -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Windows.Forms.Ribbon35" Version="3.5.8.0" />
  </ItemGroup>

  <!-- Shared sources from the parent project (single source of truth) -->
  <ItemGroup>
    <Compile Include="..\..\frmMOTW.cs" Link="frmMOTW.cs" />
    <Compile Include="..\..\frmMOTW.Designer.cs" Link="frmMOTW.Designer.cs" />
    <Compile Include="..\..\MotwUnblocker.cs" Link="MotwUnblocker.cs" />
    <Compile Include="..\..\RecentFolderItem.cs" Link="RecentFolderItem.cs" />
    <Compile Include="..\..\TextProgressBar.cs" Link="TextProgressBar.cs" />
    <Compile Include="..\..\Properties\Resources.Designer.cs" Link="Properties\Resources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\frmMOTW.resx" Link="frmMOTW.resx">
      <LogicalName>MOTW_Cleaner.frmMOTW.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\Properties\Resources.resx" Link="Properties\Resources.resx">
      <LogicalName>MOTW_Cleaner.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
