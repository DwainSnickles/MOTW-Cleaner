<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>

    <RootNamespace>MotwSetup</RootNamespace>
    <AssemblyName>MOTW Cleaner Uninstall</AssemblyName>
    <Product>MOTW Cleaner</Product>
    <Company>Dwain Snickles</Company>
    <Copyright>Copyright (c) 2026 Dwain Snickles</Copyright>
    <Version>1.3.1.0</Version>
    <FileVersion>1.3.1.0</FileVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>

    <ApplicationIcon>..\assets\motw.ico</ApplicationIcon>
    <ApplicationManifest>..\app.manifest</ApplicationManifest>

    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>UNINSTALLER;DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DefineConstants>UNINSTALLER;TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\motw.ico" LogicalName="MOTWSetup.icon.ico" />
  </ItemGroup>

</Project>
