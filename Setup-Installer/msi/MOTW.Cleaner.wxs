<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    MOTW Cleaner MSI.

    Build with:
      wix build msi\MOTW.Cleaner.wxs -ext WixToolset.UI.wixext -arch x64 ^
          -d PayloadPath="..\MOTW Portable\publish\MOTW-Cleaner-Portable.exe" ^
          -o MOTW.Installer.msi

    or simply run build-msi.ps1, which resolves the payload path for you.
  -->

  <Package Name="MOTW Cleaner"
           Manufacturer="Dwain Snickles"
           Version="1.3.2.0"
           UpgradeCode="{48969108-2635-4FE2-80AB-A7BFF2749C65}"
           Scope="perMachine"
           Compressed="yes"
           Language="1033">

    <SummaryInformation Description="MOTW Cleaner setup - unblock Mark of the Web on downloaded files"
                        Manufacturer="Dwain Snickles" />

    <!-- AllowSameVersionUpgrades lets a rebuild of the same version replace the
         earlier build instead of registering a second copy alongside it. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of MOTW Cleaner is already installed."
                  Schedule="afterInstallValidate"
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <!--
      The released 1.3.1.0 package (32-bit, product {FFBAC566-...}) installed to a
      folder of its choice and recorded it as ARP InstallLocation. Read that back so
      the upgrade replaces the app where it already lives instead of installing a
      second copy under Program Files. With nothing to read, INSTALLDIR keeps its
      Program Files default.
    -->
    <Property Id="PREVINSTALLDIR">
      <RegistrySearch Id="PreviousInstallDir" Root="HKLM" Bitness="always32"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{FFBAC566-A7D0-4947-BCB6-3C01CE30AFBA}"
                      Name="InstallLocation" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDIR" Action="SetInstallDirFromPreviousProduct"
                 Value="[PREVINSTALLDIR]"
                 Before="CostFinalize"
                 Condition="PREVINSTALLDIR" />

    <!--
      From 1.3.2.0 on the folder is remembered under our own key, so the next
      release keeps upgrading into it without depending on any one ProductCode.
    -->
    <Property Id="PREVAPPDIR">
      <RegistrySearch Id="PreviousAppDir" Root="HKLM"
                      Key="SOFTWARE\MOTW Cleaner"
                      Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLDIR" Action="SetInstallDirFromAppKey"
                 Value="[PREVAPPDIR]"
                 Before="CostFinalize"
                 Condition="PREVAPPDIR AND NOT PREVINSTALLDIR" />

    <Icon Id="MOTW.ico" SourceFile="assets\motw.ico" />
    <Property Id="ARPPRODUCTICON" Value="MOTW.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/DwainSnickles/MOTW-Cleaner" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DwainSnickles/MOTW-Cleaner" />
    <Property Id="ARPCONTACT" Value="dwainsnickles@hotmail.com" />

    <WixVariable Id="WixUIBannerBmp" Value="msi\assets\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="msi\assets\dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="msi\assets\license.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLDIR" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLDIR" Name="MOTW Cleaner">
        <Component Id="ApplicationFiles" Guid="{A1C0F3D2-6E4B-4B7A-9F3C-2D5E8B1A7C10}">
          <File Id="ApplicationExe"
                Source="$(var.PayloadPath)"
                Name="MOTW Cleaner.exe"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MOTW Cleaner">
        <Component Id="StartMenuShortcut" Guid="{B2D4E5F6-7A8B-4C9D-8E1F-3A5B7C9D1E20}">
          <Shortcut Id="StartMenuLink"
                    Name="MOTW Cleaner"
                    Description="Unblock Mark of the Web on downloaded files"
                    Target="[INSTALLDIR]MOTW Cleaner.exe"
                    WorkingDirectory="INSTALLDIR"
                    Icon="MOTW.ico" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\MOTW Cleaner" Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{C3E5F6A7-8B9C-4D1E-9F2A-4B6C8D0E2F30}">
        <Shortcut Id="DesktopLink"
                  Name="MOTW Cleaner"
                  Description="Unblock Mark of the Web on downloaded files"
                  Target="[INSTALLDIR]MOTW Cleaner.exe"
                  WorkingDirectory="INSTALLDIR"
                  Icon="MOTW.ico" />
        <RegistryValue Root="HKLM" Key="Software\MOTW Cleaner" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Component Id="InstallLocation" Directory="INSTALLDIR" Guid="{E5A7B9C0-2D3E-4F41-8B5C-7D9E1F3A4B51}">
      <RegistryKey Root="HKLM" Key="Software\MOTW Cleaner">
        <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
      </RegistryKey>
    </Component>

    <Component Id="AppPaths" Directory="INSTALLDIR" Guid="{D4F6A7B8-9C1D-4E2F-8A3B-5C7D9E1F3A40}">
      <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\MOTW Cleaner.exe">
        <RegistryValue Type="string" Value="[INSTALLDIR]MOTW Cleaner.exe" />
        <RegistryValue Name="Path" Type="string" Value="[INSTALLDIR]" />
      </RegistryKey>
    </Component>

    <Feature Id="MainFeature" Title="MOTW Cleaner" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="InstallLocation" />
      <ComponentRef Id="AppPaths" />
    </Feature>

  </Package>
</Wix>
